{
  "name": "witty",
  "version": "0.2.3",
  "description": "Hosts a program in a passthrough ConPTY and translates its kitty graphics into sixel, so images show in Windows Terminal and Tabby.",
  "type": "module",
  "license": "MIT",
  "author": "Kyle Toney",
  "repository": {
    "type": "git",
    "url": "https://github.com/toneydev/witty.git"
  },
  "homepage": "https://github.com/toneydev/witty#readme",
  "bugs": {
    "url": "https://github.com/toneydev/witty/issues"
  },
  "keywords": [
    "kitty",
    "graphics",
    "sixel",
    "conpty",
    "windows-terminal",
    "tabby",
    "claude-code"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "witty": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node src/cli.ts"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.18",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  }
}
